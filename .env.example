# Figma Token Sync - Environment Variables
# Copy this file to .env and fill in your actual values

# Figma Personal Access Token
# Get yours at: https://www.figma.com/developers/api#access-tokens
# Required for: REST API operations (if using API in future)
FIGMA_ACCESS_TOKEN=your_figma_token_here

# Notion API Key (optional)
# Get yours at: https://www.notion.so/my-integrations
# Required for: Notion integration features
NOTION_API_KEY=your_notion_key_here
